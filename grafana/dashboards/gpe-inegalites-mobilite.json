          "datasource": "PostgreSQL",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH pauvres_aidees AS (\n    SELECT COUNT(*) as nb,\n           SUM(CASE WHEN g.nb_gares_gpe_futures > 0 THEN 1 ELSE 0 END) as avec_gpe\n    FROM mart.gain_mobilite g\n    JOIN mart.accessibilite_par_commune a USING (code_commune)\n    WHERE a.revenu_median < 22000\n),\nriches_aides AS (\n    SELECT COUNT(*) as nb,\n           SUM(CASE WHEN g.nb_gares_gpe_futures > 0 THEN 1 ELSE 0 END) as avec_gpe\n    FROM mart.gain_mobilite g\n    JOIN mart.accessibilite_par_commune a USING (code_commune)\n    WHERE a.revenu_median >= 33000\n)\nSELECT \n    ROUND(100.0 * (p.avec_gpe / p.nb::numeric - r.avec_gpe / r.nb::numeric), 2) as value\nFROM pauvres_aidees p, riches_aides r;",
          "refId": "A"
        }
      ],
