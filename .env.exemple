# Base de données PostgreSQL
POSTGRES_USER=           # ex: gpe
POSTGRES_PASSWORD=       # choisir un mot de passe fort
POSTGRES_DB=             # ex: gpe

# URL de connexion complète (utilisée par les scripts Python et le Makefile)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Airflow
AIRFLOW_ADMIN_USER=      # ex: admin
AIRFLOW_ADMIN_PASSWORD=  # choisir un mot de passe fort

# Grafana
GRAFANA_ADMIN_USER=      # ex: admin
GRAFANA_ADMIN_PASSWORD=  # choisir un mot de passe fort
