# ============================================================================
# TODO: PRODUCTION AIRFLOW IMPLEMENTATION
# ============================================================================
# This Dockerfile is NOT USED in development (Airflow runs locally instead).
# Left here as a starting point for future production containerization.
#
# BLOCKER: Python version incompatibility
#   - apache/airflow:2.8.1 uses Python 3.8
#   - Project requires Python 3.11 (requirements.txt)
#   - Fiona and other deps don't compile on Python 3.8
#
# OPTIONS TO EXPLORE:
#   1. Find an Airflow image with Python 3.11 support
#   2. Build custom image: python:3.11 base + pip install apache-airflow
#   3. Use newer Airflow version (3.0+) that supports Python 3.11
#
# For now: Airflow runs locally in dev, PostgreSQL/Grafana via docker-compose.

FROM apache/airflow:2.8.1

USER root

# Installer les dépendances système
RUN apt-get update && apt-get install -y build-essential postgresql-client libgdal-dev && apt-get clean && rm -rf /var/lib/apt/lists/*

USER airflow

# Copier et installer les dépendances du projet
COPY requirements.txt /opt/airflow/requirements.txt
RUN pip install --no-cache-dir -r /opt/airflow/requirements.txt

# Copier le code du projet
COPY --chown=airflow:airflow ingestion/ /opt/airflow/ingestion/
COPY --chown=airflow:airflow dags/ /opt/airflow/dags/
COPY --chown=airflow:airflow ml/ /opt/airflow/ml/

# Configurer PYTHONPATH
ENV PYTHONPATH=/opt/airflow
